# Line-ending normalization — safe defaults for cross-platform work.
# No Git LFS rules: the .dmg installer is distributed via GitHub Releases,
# not committed to the repo, so LFS isn't needed.

* text=auto

# Text files: normalize to LF in the repo, convert to native on checkout.
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf

# Binary assets — never try to diff or normalize these.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.webp      binary
